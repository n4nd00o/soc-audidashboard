# Copy to deploy/.env and replace every CHANGE_ME (the server refuses secrets < 32 chars).
# Generate each secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Secrets MUST be URL-safe (only A-Z a-z 0-9 - _, as token_urlsafe produces): the proxy secret
# is substituted raw into the Caddyfile and POSTGRES_PASSWORD into the database URL.
# Never commit deploy/.env.
AUDIDASH_SECRET_KEY=CHANGE_ME
AUDIDASH_PROXY_SECRET=CHANGE_ME
AUDIDASH_CA_PASSPHRASE=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Optional (defaults shown).
# Host address the 8443/9443 ports are published on (0.0.0.0 exposes them to the LAN).
#AUDIDASH_BIND_ADDRESS=127.0.0.1
# SANs of the :8443 dashboard certificate issued by the internal CA (must match the
# `audidash enroll --server` host name; IP literals allowed).
#AUDIDASH_DASHBOARD_HOSTS=localhost,127.0.0.1
# SANs of the :9443 certificate issued by the internal CA (must match `audidash --api`).
#AUDIDASH_API_HOSTS=localhost,127.0.0.1
#AUDIDASH_PUBLIC_DASHBOARD_URL=https://localhost:8443
#AUDIDASH_PUBLIC_API_URL=https://localhost:9443
